# Copy to .env (in this folder OR the folder above it). Never commit the real file.

# For live episodes set ONE of these (the app only ever uses gpt-6-luna). If both are set, Portkey is used.
PORTKEY_API_KEY=

# Your own OpenAI key: used directly when no Portkey key is set (also used for OpenAI TTS if Kokoro isn't installed).
OPENAI_API_KEY=

# Optional: live (default) | cached (bundled wiki pages only, no internet) | demo (no key needed, plays the sample episode)
LOREMASTER_DATA_MODE=live
